#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------

CORS_ALLOWED_ORIGINS = http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://app.jmrtextile.com,https://jmrtextile.com
# CORS_ALLOWED_ORIGIN_PATTERNS =
